{
  "name": "algor-language",
  "displayName": "ALGOR Programming Language",
  "description": "ALGOR programlama dili için VS Code desteği",
  "icon": "algor-logo-128.png",
  "version": "0.1.1",
  "publisher": "AlgorProgramming",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "algor",
        "aliases": [
          "ALGOR",
          "algor"
        ],
        "extensions": [
          ".algor"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "algor",
        "scopeName": "source.algor",
        "path": "./syntaxes/algor.tmLanguage.json"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/enestahayondem/Algor.git"
  },
  "license": "MIT",
  "pricing": "Free"
}
