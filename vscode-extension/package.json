{
  "name": "algor-language",
  "displayName": "ALGOR Programming Language",
  "description": "ALGOR programlama dili için resmi VS Code desteği",
  "icon": "algor-logo-128.png",
  "version": "1.0.1",
  "publisher": "AlgorProgramming",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "algor",
    "programming",
    "turkish",
    "language"
  ],
  "contributes": {
    "languages": [
      {
        "id": "algor",
        "aliases": [
          "ALGOR",
          "algor"
        ],
        "extensions": [
          ".algor"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "algor",
        "scopeName": "source.algor",
        "path": "./syntaxes/algor.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "algor",
        "path": "./snippets/algor.code-snippets"
      }
    ],
    "iconThemes": [
      {
        "id": "algor-icon-theme",
        "label": "ALGOR File Icons",
        "path": "./icons/algor-icon-theme.json"
      }
    ],
    "commands": [
      {
        "command": "algor.runFile",
        "title": "ALGOR: Dosyayı Çalıştır",
        "icon": "$(play)"
      }
    ],
    "keybindings": [
      {
        "command": "algor.runFile",
        "key": "alt+cmd+r",
        "mac": "alt+cmd+r",
        "when": "editorTextFocus && editorLangId == algor"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "algor.runFile",
          "when": "editorLangId == algor",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "algor.runFile",
          "when": "editorLangId == algor",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "algor.runFile",
          "when": "resourceExtname == .algor",
          "group": "navigation"
        }
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/enestahayondem/Algor.git"
  },
  "license": "MIT",
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:algor",
    "onCommand:algor.runFile"
  ]
}
