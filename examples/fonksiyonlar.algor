// ALGOR fonksiyon sistemi demo

fonksiyon topla(sayi a, sayi b) {
    dondur a + b
}

fonksiyon faktoriyel(sayi n) {
    eger n <= 1 {
        dondur 1
    }

    dondur n * faktoriyel(n - 1)
}

fonksiyon selamla(metin isim) {
    dondur "Merhaba " + isim
}

sayi sonuc = topla(15, 25)

yaz("Toplama:", sonuc)
yaz("Faktoriyel:", faktoriyel(5))
yaz(selamla("ALGOR"))
